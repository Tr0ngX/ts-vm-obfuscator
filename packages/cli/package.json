{
  "name": "@tsvm/cli",
  "version": "0.1.2",
  "files": [
    "dist",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "ts-obfuscate": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup ./src/cli.ts --format esm --clean",
    "start": "node ./dist/cli.js",
    "dev": "tsup ./src/cli.ts --format esm --watch",
    "test": "pnpm --dir ../.. exec vitest run packages/cli/tests/**/*.test.ts --config vitest.config.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tsvm/shared": "workspace:*",
    "@tsvm/core": "workspace:*",
    "commander": "^13.1.0",
    "chalk": "^5.4.1",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  }
}
